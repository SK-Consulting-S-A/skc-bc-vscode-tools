{
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.82"
      ],
      "env": {
        "PLAYWRIGHT_BROWSER": "msedge"
      }
    },
    "MS Learn Docs": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp",
      "headers": {}
    },
    "bc-intelligence": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "bc-code-intelligence-mcp@1.7.6"
      ]
    },
    "businesscentral": {
      "type": "http",
      "url": "https://mcp.businesscentral.dynamics.com",
      "headers": {
        "TenantId": "${input:bcTenantId}",
        "EnvironmentName": "${input:bcEnvironmentName}",
        "Company": "${input:bcCompany}",
        "ConfigurationName": ""
      }
    },
    "mcp-pandoc": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-pandoc==0.11.1"
      ]
    },
    "microsoft/markitdown": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "markitdown-mcp@0.0.1a4"
      ]
    }
  },
  "inputs": [
    {
      "id": "bcTenantId",
      "type": "promptString",
      "description": "Business Central: Microsoft Entra tenant ID (GUID)"
    },
    {
      "id": "bcEnvironmentName",
      "type": "promptString",
      "description": "Business Central: environment name (use a sandbox unless production access is intended)"
    },
    {
      "id": "bcCompany",
      "type": "promptString",
      "description": "Business Central: company name (non-ASCII names must be =?base64?<UTF-8 Base64>?=)"
    }
  ]
}