  "tokenColors": [
    {
      "name": "Base",
      "scope": [
        "meta.embedded",
        "source.groovy.embedded"
      ],
      "settings": {
        "foreground": "#171528"
      }
    },
    {
      "name": "Emphasis",
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strong",
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#77738a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
