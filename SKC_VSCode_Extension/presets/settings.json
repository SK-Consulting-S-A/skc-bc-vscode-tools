{
  "extensions": [
    "usernamehw.errorlens",
    "GitHub.vscode-pull-request-github",
    "ms-vscode.PowerShell",
    "vscode-icons-team.vscode-icons",
    "ms-dynamics-smb.al",
    "SKConsultingSA.skc-al-workspace",
    "rasmus.al-var-helper",
    "redhat.vscode-xml",
    "ms-vscode.vscode-typescript-next",
    "dbaeumer.vscode-eslint",
    "esbenp.prettier-vscode",
    "ms-python.python",
    "ms-python.vscode-pylance",
    "ms-python.debugpy",
    "ms-python.vscode-python-envs",
    "ms-azuretools.vscode-azurefunctions",
    "ms-azuretools.vscode-azureappservice",
    "ms-azuretools.vscode-azureresourcegroups",
    "ms-copilotstudio.vscode-copilotstudio",
    "danish-naglekar.dataverse-devtools",
    "danish-naglekar.pcf-builder",
    "analysis-services.tmdl",
    "analysis-services.powerbi-modeling-mcp",
    "GerhardBrueckl.powerbi-vscode"
  ],
  "settings": {
    "alWorkspace.onSaveAction": "Nothing",
    "alWorkspace.fileNamePattern": "<ObjectNameShort>.<ObjectTypeShortPascalCase>.al",
    "alWorkspace.extensionFileNamePattern": "<ObjectNameShort>.<ObjectTypeShortPascalCase>.al",
    "alWorkspace.pageCustomizationFileNamePattern": "<ObjectNameShort>.<ObjectTypeShortPascalCase>.al",
    "alWorkspace.organizationMode": "Namespace",
    "alWorkspace.sourceRoot": "src",
    "alWorkspace.testSourceRoot": "",
    "alWorkspace.namespacePrefixToIgnore": "",
    "alWorkspace.affixesToRemove": [],
    "alWorkspace.objectNamePrefix": "",
    "alWorkspace.objectNameSuffix": "",
    "alWorkspace.rewriteObjectName": false,
    "al.enableCodeAnalysis": true,
    "al.codeAnalyzers": [
      "${CodeCop}",
      "${UICop}"
    ],
    "al.areProfileLensesSupported": true,
    "al.inlayhints.parameterNames.enabled": true,
    "al.inlayhints.functionReturnTypes.enabled": true,
    "alOutline.defaultDataClassification": "Customer Content",
    "alCodeActions.extractToLabelCreatesComment": true,
    "alOutline.addToolTipsToPageFields": true,
    "alOutline.enableCodeCopFixes": true,
    "alOutline.fixCodeCopMissingParenthesesOnSave": true,
    "al.backgroundCodeAnalysis": true,
    "al.compilationOptions": {
      "parallel": true,
      "generateReportLayout": true
    },
    "al.enableCodeActions": true,
    "al.incrementalBuild": true,
    "alOutline.codeActionsOnSave": [
      "SortVariables",
      "FormatDocument",
      "SortCustomizations",
      "SortProcedures",
      "SortProperties",
      "SortTableFields",
      "SortPermissions",
      "SortPermissionSetList"
    ],
    "alOutline.appAreaMode": "inheritFromMainObject",
    "alOutline.codeCleanupActions": [
      "AddApplicationAreas",
      "AddDataClassifications",
      "AddEnumValuesCaptions",
      "AddMissingParentheses",
      "AddObjectCaptions",
      "AddPageFieldCaptions",
      "AddTableFieldCaptions",
      "AddToolTips",
      "ConvertObjectIdsToNames",
      "FixKeywordsCase",
      "FixIdentifiersCase",
      "FormatDocument",
      "RemoveEmptyLines",
      "TrimTrailingWhitespace"
    ],
    "alOutline.pageActionToolTip": "Executes the %1 action",
    "alOutline.pageFieldToolTip": "Specifies the value of the %1 field",
    "al.snapshotDebuggingPath": "./.snapshot",
    "NAB.UseDTS": true,
    "NAB.LoadSymbols": true,
    "alCodeActions.findNewProcedureLocation": "Sort by type, access modifier, range",
    "editor.inlineSuggest.enabled": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    },
    "editor.language.brackets": [],
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "git.openRepositoryInParentFolders": "always",
    "settingsSync.ignoredSettings": [],
    "settingsSync.ignoredExtensions": [],
    "[al]": {
      "editor.wordBasedSuggestions": "off",
      "editor.suggestSelection": "first",
      "editor.formatOnSave": true
    },
    "[json]": {
      "editor.defaultFormatter": "vscode.json-language-features"
    },
    "workbench.iconTheme": "vscode-icons",
    "workbench.colorTheme": "SKC Dark",
    "workbench.preferredDarkColorTheme": "SKC Dark",
    "workbench.preferredLightColorTheme": "SKC Light",
    "workbench.startupEditor": "none",
    "workbench.settings.applyToAllProfiles": [
      "al.inlayhints.functionReturnTypes.enabled",
      "al.inlayhints.parameterNames.enabled"
    ],
    "workbench.activityBar.orientation": "vertical",
    "vsicons.dontShowNewVersionMessage": true,
    "window.commandCenter": true,
    "editor.experimentalGpuAcceleration": "on",
    "editor.lightbulb.enabled": "onCode",
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.enableImages": true,
    "augment.nextEdit.highlightSuggestionsInTheEditor": true,
    "augment.nextEdit.enableGlobalBackgroundSuggestions": true,
    "cSpell.overrides": [],
    "extensions.gallery.serviceUrl": "https://marketplace.visualstudio.com/_apis/public/gallery",
    "objectIdNinja.backEndUrl": "objectninja-backend.azurewebsites.net",
    "objectIdNinja.backEndUrlPoll": "objectninja-pool.azurewebsites.net",
    "al.showHomeAtStartup": "Always"
  }
}