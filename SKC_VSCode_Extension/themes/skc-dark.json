      "settings": { "foreground": "#8a83ff" }
    },
    {
      "name": "XML / XLF tags",
      "scope": ["entity.name.tag.xml", "entity.name.tag.xliff"],
      "settings": { "foreground": "#8a83ff" }
    }
  ]
