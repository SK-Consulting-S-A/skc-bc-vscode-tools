  "semanticTokenColors": {
    "class": "#00d4ff",
    "interface": "#00d4ff",
    "enum": "#00d4ff",
    "type": "#00d4ff",
    "typeParameter": "#00d4ff",
    "struct": "#00d4ff",
    "function": "#E8D48A",
    "method": "#E8D48A",
    "macro": "#8a83ff",
    "namespace": "#00d4ff",
    "parameter": "#c5d0f0",
    "property": "#c5d0f0",
    "variable": "#c5d0f0",
    "variable.readonly": "#b4e0ff",
    "enumMember": "#b4e0ff",
    "keyword": "#8a83ff",
    "comment": "#6e6e92",
    "string": "#ce9178",
    "number": "#b5cea8",
    "operator": "#e0e0f0",
    "newOperator": "#ff6cf0",
    "stringLiteral": "#ce9178",
    "customLiteral": "#E8D48A",
    "numberLiteral": "#b5cea8"
  },
  "tokenColors": [
    {
      "scope": ["meta.embedded", "source.groovy.embedded", "string meta.image.inline.markdown", "variable.legacy.builtin.python"],
      "settings": { "foreground": "#e0e0f0" }
    },
    {
      "scope": "emphasis",
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": "strong",
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": "comment",
      "settings": { "foreground": "#6e6e92", "fontStyle": "italic" }
    },
    {
      "scope": "constant.language",
      "settings": { "foreground": "#8a83ff" }
    },
    {
      "scope": ["constant.numeric", "variable.other.enummember", "keyword.operator.plus.exponent", "keyword.operator.minus.exponent"],
      "settings": { "foreground": "#b5cea8" }
    },
    {
      "scope": "constant.regexp",
      "settings": { "foreground": "#ff6cf0" }
    },
    {
      "scope": "entity.name.tag",
      "settings": { "foreground": "#8a83ff" }
    },
    {
      "scope": ["entity.name.tag.css", "entity.name.tag.less"],
      "settings": { "foreground": "#FBBF24" }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#c5d0f0" }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
        "source.css entity.other.attribute-name.class",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.parent-selector.css",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element.css",
        "entity.other.attribute-name.scss"
      ],
      "settings": { "foreground": "#FBBF24" }
    },
    {
      "scope": "invalid",
      "settings": { "foreground": "#F87171" }
    },
    {
      "scope": "markup.underline",
      "settings": { "fontStyle": "underline" }
    },
    {
      "scope": "markup.bold",
      "settings": { "fontStyle": "bold", "foreground": "#8a83ff" }
    },
    {
      "scope": "markup.heading",
      "settings": { "fontStyle": "bold", "foreground": "#00d4ff" }
    },
    {
      "scope": "markup.italic",
      "settings": { "fontStyle": "italic", "foreground": "#ff6cf0" }
    },
    {
      "scope": "markup.strikethrough",
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "scope": "markup.inserted",
      "settings": { "foreground": "#34D399" }
    },
    {
      "scope": "markup.deleted",
      "settings": { "foreground": "#F87171" }
    },
    {
      "scope": "markup.changed",
      "settings": { "foreground": "#00d4ff" }
    },
    {
      "scope": "punctuation.definition.quote.begin.markdown",
      "settings": { "foreground": "#6e6e92" }
    },
    {
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": { "foreground": "#6c63ff" }
    },
    {
      "scope": "markup.inline.raw",
      "settings": { "foreground": "#ce9178" }
    },
    {
      "name": "Tag brackets",
      "scope": "punctuation.definition.tag",
      "settings": { "foreground": "#7878a0" }
    },
    {
      "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": { "foreground": "#8a83ff" }
    },
    {
      "scope": "meta.preprocessor.string",
      "settings": { "foreground": "#ce9178" }
    },
    {
      "scope": "meta.preprocessor.numeric",
      "settings": { "foreground": "#b5cea8" }
    },
    {
      "scope": "meta.structure.dictionary.key.python",
      "settings": { "foreground": "#c5d0f0" }
    },
    {
      "scope": "meta.diff.header",
      "settings": { "foreground": "#8a83ff" }
    },
    {
      "scope": ["storage", "storage.type", "storage.modifier", "keyword.operator.noexcept"],
      "settings": { "foreground": "#8a83ff" }
    },
    {
      "scope": ["string", "meta.embedded.assembly", "string.tag", "string.value"],
      "settings": { "foreground": "#ce9178" }
    },
    {
      "scope": "string.regexp",
      "settings": { "foreground": "#F87171" }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#8a83ff" }
    },
    {
      "scope": ["meta.template.expression"],
      "settings": { "foreground": "#e0e0f0" }
    },
    {
      "scope": [
        "support.type.vendored.property-name",
        "support.type.property-name",
        "source.css variable",
        "source.coffee.embedded"
      ],
      "settings": { "foreground": "#c5d0f0" }
    },
    {
      "scope": ["keyword", "keyword.control"],
      "settings": { "foreground": "#8a83ff" }
    },
    {
      "scope": "keyword.operator",
      "settings": { "foreground": "#e0e0f0" }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.instanceof",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike"
      ],
      "settings": { "foreground": "#8a83ff" }
    },
    {
      "scope": "keyword.other.unit",
      "settings": { "foreground": "#b5cea8" }
    },
    {
      "name": "this.self",
      "scope": "variable.language",
      "settings": { "foreground": "#8a83ff" }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.constant.handlebars",
        "source.powershell variable.other.member",
        "entity.name.operator.custom-literal"
      ],
      "settings": { "foreground": "#E8D48A" }
